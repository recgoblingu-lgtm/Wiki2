<script>
const pages = [
  "articles/Rec_Room.html",
  "articles/Rec_Room_Network.html",
  "articles/Golden_age_of_arcade_video_games.html",
  "articles/Lasagna.html",
  "articles/Pasta.html",
  "articles/Squishy_Dumpling_Thingys.html",
  "articles/Dolly_Parton.html"
];

function randomPage() {
  const pick = pages[Math.floor(Math.random() * pages.length)];
  window.location.href = pick;
}
</script>

